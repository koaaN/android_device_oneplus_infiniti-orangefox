+static int Process_lpmake_super(const char *path, int* wipe_cache) {
+	(void)wipe_cache;
+	int ret_val = INSTALL_SUCCESS;
+	char command[PATH_MAX];
+	int pipe_fd[2];
+	FILE* child_data;
+	char buffer[1024];
+
+	if (pipe(pipe_fd) != 0) {
+		LOGERR("Failed to create pipe for flashtool.sh: %s\n", strerror(errno));
+		return INSTALL_ERROR;
+	}
 
-  return ret_val;
+	snprintf(command, sizeof(command), "/system/bin/flashtool.sh \"%s\" 0 0 %d", path, pipe_fd[1]);
+	LOGINFO("Executing flashtool command: %s\n", command);
+
+	pid_t pid = fork();
+	if (pid == 0) {
+		close(pipe_fd[0]);
+		execl("/system/bin/sh", "sh", "-c", command, (char*)NULL);
+		LOGERR("Failed to execute flashtool.sh: %s\n", strerror(errno));
+		_exit(INSTALL_ERROR);
+	} else if (pid < 0) {
+		LOGERR("Failed to fork process for flashtool.sh: %s\n", strerror(errno));
+		close(pipe_fd[0]);
+		close(pipe_fd[1]);
+		return INSTALL_ERROR;
+	}
+
+	close(pipe_fd[1]);
+	child_data = fdopen(pipe_fd[0], "r");
+	if (!child_data) {
+		LOGERR("Failed to open pipe for reading: %s\n", strerror(errno));
+		close(pipe_fd[0]);
+		waitpid(pid, NULL, 0);
+		return INSTALL_ERROR;
+	}
+
+	while (fgets(buffer, sizeof(buffer), child_data) != NULL) {
+		char* cmd = strtok(buffer, " \n");
+		if (!cmd) continue;
+
+		if (strcmp(cmd, "progress") == 0) {
+			char* fraction_str = strtok(NULL, " \n");
+			char* seconds_str = strtok(NULL, " \n");
+			if (fraction_str && seconds_str) {
+				float fraction = strtof(fraction_str, NULL);
+				int seconds = strtol(seconds_str, NULL, 10);
+				DataManager::ShowProgress(fraction, seconds);
+			}
+		}
+		else if (strcmp(cmd, "ui_print") == 0) {
+			char* msg = strtok(NULL, "\n");
+			if (msg) gui_print("%s", msg);
+			else gui_print("\n");
+		}
+	}
+
+	int status;
+	waitpid(pid, &status, 0);
+	fclose(child_data);
+
+	if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		LOGERR("flashtool.sh execution failed (exit code: %d)\n", WEXITSTATUS(status));
+		gui_err("lpmake_super_fail=install failed!");
+		ret_val = INSTALL_ERROR;
+	} else {
+		gui_msg("lpmake_super_success=install completed successfully!");
+	}
+	DataManager::SetValue("tw_install_super", 0);
+	return ret_val;
 }
